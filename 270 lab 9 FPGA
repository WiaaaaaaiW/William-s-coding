//send the boards 50MHz clock to this and on the output will be 1Hz clock
module clock_divider(
	input clk,
	output reg new_clk
);
	reg [27:0] counter = 0;
	always@(posedge clk)
	begin
		if(counter == 28'd25_000_000)
		begin
			counter <= counter + 1;
			new_clk <= 1;
		end else if(counter == 28'd50_000_000)
		begin
			counter <= 0;
			new_clk <= 0;
		end else begin
			counter <= counter + 1;
			new_clk <= new_clk;
		end
	end
endmodule

//connect the push buttons of the boards to the input pins of this module and the output is what you will you to control your state machine
//the clock that gets sent to this is the 1Hz clock that comes from the output above.

module edge_detection
(
	input clk1,
	input clk2,
	input cent_25,
	input cent_50,
	input reset,
	output reg new_cent_25,
	output reg new_cent_50,
	output reg new_reset
);
	reg reset_hold;
	reg cent_25_hold;
	reg cent_50_hold;
	
	reg cent_25_hold_old;
	reg cent_50_hold_old;
	reg reset_hold_old;
	
	reg cent_25_old;
	reg cent_50_old;
	reg reset_old;
	
	
	always@(posedge clk1)
	begin
		reset_old <= reset;
		if(reset_old == 1 & reset==0)
		begin
			reset_hold <= 1;
		end else if (new_reset == 1)
		begin
			reset_hold <= 0;
		end
		
		cent_25_old <= cent_25;
		if(cent_25_old == 1 & cent_25==0)
		begin
			cent_25_hold <= 1;
		end else if (new_cent_25 == 1)
		begin
			cent_25_hold <= 0;
		end
		
		
		cent_50_old <= cent_50;
		if(cent_50_old == 1 & cent_50==0)
		begin
			cent_50_hold <= 1;
		end else if (new_cent_50 == 1)
		begin
			cent_50_hold <= 0;
		end
	end
	
	always@(posedge clk2)
    begin
		cent_25_hold_old <= cent_25_hold;
		cent_50_hold_old <= cent_50_hold;
		reset_hold_old <= reset_hold;
		
		if(cent_25_hold_old == 0 & cent_25_hold==1)
		begin
			new_cent_25 <= 1;
		end
		else if (new_cent_25 == 1)
		begin
			new_cent_25 <= 0;
		end
		
		if(cent_50_hold_old == 0 & cent_50_hold==1)
		begin
			new_cent_50 <= 1;
		end
		else if (new_cent_50 == 1)
		begin
			new_cent_50 <= 0;
		end
		
		if(reset_hold_old == 0 & reset_hold==1)
		begin
			new_reset <= 1;
		end
		else if (new_reset == 1)
		begin
			new_reset <= 0;
		end

	end
endmodule

module ssd_hex(
  input [3:0] Num,        // 4-bit input number (0–F)
  output reg [6:0] SevenSeg // 7-bit output for segments (a–g)
);

always@(*) // run when any input changes
begin
  case(Num)
    4'b0000: SevenSeg = 7'b1000000; // 0
    4'b0001: SevenSeg = 7'b1111001; // 1
    4'b0010: SevenSeg = 7'b0100100; // 2
    4'b0011: SevenSeg = 7'b0110000; // 3
    4'b0100: SevenSeg = 7'b0011001; // 4
    4'b0101: SevenSeg = 7'b0010010; // 5
    4'b0110: SevenSeg = 7'b0000010; // 6
    4'b0111: SevenSeg = 7'b1111000; // 7
    4'b1000: SevenSeg = 7'b0000000; // 8
    4'b1001: SevenSeg = 7'b0010000; // 9
    4'b1010: SevenSeg = 7'b0001000; // A
    4'b1011: SevenSeg = 7'b0000011; // B
    4'b1100: SevenSeg = 7'b1000110; // C
    4'b1101: SevenSeg = 7'b0100001; // D
    4'b1110: SevenSeg = 7'b0000110; // E
    4'b1111: SevenSeg = 7'b0001110; // F
  endcase
end

endmodule

module myFSM(
    input clk,
    input cent_25,
    input cent_50,
    input reset,
    output reg food,
    output reg change,
    output reg [3:0] stateDisplay
);

reg [1:0] state;
parameter S0 = 2'b00,
          S1 = 2'b01,
          S2 = 2'b10; // 50¢ holding state

// Sequential Block: state transitions and synchronous outputs
always @(posedge clk)
begin
    if (reset) begin
        state <= S0;
        food <= 0;
        change <= 0;
    end
    else if (!(cent_25 & cent_50)) begin // ignore simultaneous input
        // Default outputs
        food <= 0;
        change <= 0;

        case(state)
            S0: begin
                if (cent_25)
                    state <= S1;
                else if (cent_50)
                    state <= S2;
            end
            S1: begin
                if (cent_25)
                    state <= S2;           // 25+25=50
                else if (cent_50) begin
                    state <= S0;           // 25+50=75 → dispense
                    food <= 1;
                end
            end
            S2: begin
                if (cent_25) begin
                    state <= S0;           // 50+25=75 → dispense
                    food <= 1;
                end
                else if (cent_50) begin
                    state <= S0;           // 50+50=100 → dispense + change
                    food <= 1;
                    change <= 1;
                end
            end
        endcase
    end
end

// Optional: display current state on LEDs
always @* begin
    stateDisplay = state;
end

endmodule

