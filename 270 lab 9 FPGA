//send the boards 50MHz clock to this and on the output will be 1Hz clock
module clock(
    input clk_50M,
    output reg clk_1
);
    reg [27:0] counter = 0;
    always@(posedge clk_50M)
    begin
        if(counter == 28'd25_000_000)
        begin
            counter <= counter + 1;
            clk_1 <= 1;
        end else if(counter == 28'd50_000_000)
        begin
            counter <= 0;
            clk_1 <= 0;
        end else begin
            counter <= counter + 1;
            clk_1 <= clk_1;
        end
    end
endmodule


module edge_detection
(
    input clk1,
    input clk2,
    input cent_25,
    input cent_50,
    input reset,
    output reg new_cent_25,
    output reg new_cent_50,
    output reg new_reset
);
    reg reset_hold;
    reg cent_25_hold;
    reg cent_50_hold;
    
    reg cent_25_hold_old;
    reg cent_50_hold_old;
    reg reset_hold_old;
    
    reg cent_25_old;
    reg cent_50_old;
    reg reset_old;
    
    
    always@(posedge clk1) begin
        reset_old <= reset;
        if(reset_old == 1 & reset==0) begin
            reset_hold <= 1;
        end else if (new_reset == 1) begin
            reset_hold <= 0;
        end
        
        cent_25_old <= cent_25;
        if(cent_25_old == 1 & cent_25==0) begin
            cent_25_hold <= 1;
        end else if (new_cent_25 == 1) begin
            cent_25_hold <= 0;
        end
        
        cent_50_old <= cent_50;
        if(cent_50_old == 1 & cent_50==0) begin
            cent_50_hold <= 1;
        end else if (new_cent_50 == 1) begin
            cent_50_hold <= 0;
        end
    end
    
    always@(posedge clk2) begin
        cent_25_hold_old <= cent_25_hold;
        cent_50_hold_old <= cent_50_hold;
        reset_hold_old   <= reset_hold;
        
        if(cent_25_hold_old == 0 & cent_25_hold==1) begin
            new_cent_25 <= 1;
        end else if (new_cent_25 == 1) begin
            new_cent_25 <= 0;
        end
        
        if(cent_50_hold_old == 0 & cent_50_hold==1) begin
            new_cent_50 <= 1;
        end else if (new_cent_50 == 1) begin
            new_cent_50 <= 0;
        end
        
        if(reset_hold_old == 0 & reset_hold==1) begin
            new_reset <= 1;
        end else if (new_reset == 1) begin
            new_reset <= 0;
        end
    end
endmodule


module vending_fsm (
    input        clk,
    input        reset,
    input        coin25,
    input        coin50,
    output reg   food,
    output reg   change,
    output reg [1:0] state    // 00=S0, 01=S1, 10=S2
);

    localparam S0 = 2'b00;   // 0 cents
    localparam S1 = 2'b01;   // 25 cents
    localparam S2 = 2'b10;   // 50 cents

    reg [1:0] next_state;

    always @(*) begin
        next_state = state;
        food       = 1'b0;
        change     = 1'b0;

        case (state)
            S0: begin
                if (coin25 && !coin50)       next_state = S1;
                else if (!coin25 && coin50)  next_state = S2;
                else                         next_state = S0;  // 00 or 11 -> stay
            end

            S1: begin
                if (!coin25 && !coin50)      next_state = S1;
                else if (!coin25 && coin50) begin
                    // 25 + 50 = 75
                    next_state = S0;
                    food       = 1'b1;
                    change     = 1'b0;
                end
                else if (coin25 && !coin50)  next_state = S2; // 25+25=50
                else                         next_state = S1; // 11 ignore
            end

            S2: begin
                if (!coin25 && !coin50)      next_state = S2;
                else if (!coin25 && coin50) begin
                    // 50 + 50 = 100 -> food + change
                    next_state = S0;
                    food       = 1'b1;
                    change     = 1'b1;
                end
                else if (coin25 && !coin50) begin
                    // 50 + 25 = 75 -> food only
                    next_state = S0;
                    food       = 1'b1;
                    change     = 1'b0;
                end
                else                         next_state = S2; // 11 ignore
            end

            default: next_state = S0;
        endcase
    end

    always @(posedge clk) begin
        if (reset)
            state <= S0;
        else
            state <= next_state;
    end
endmodule


module myFSM(
    input  wire clk,
    input  wire C25,
    input  wire C50,
    input  wire reset,
    output wire f,
    output wire Ch,
    output wire [1:0] ssd
);
    vending_fsm U (
        .clk    (clk),
        .reset  (reset),
        .coin25 (C25),
        .coin50 (C50),
        .food   (f),
        .change (Ch),
        .state  (ssd)
    );
endmodule

