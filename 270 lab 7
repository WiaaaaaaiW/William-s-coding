`timescale 1ns/1ps

// 1-bit Full Adder
module full_adder (A, B, Cin, Sum, Cout);
  input  wire A, B, Cin;
  output wire Sum, Cout;

  assign Sum  = A ^ B ^ Cin;
  assign Cout = (A & B) | (B & Cin) | (A & Cin);
endmodule

// 4-bit Ripple Carry Adder
module adder4 (A, B, Cin, Sum, Cout);
  input  wire [3:0] A, B;
  input  wire       Cin;
  output wire [3:0] Sum;
  output wire       Cout;

  wire C1, C2, C3;

  full_adder FA0 (A[0], B[0], Cin, Sum[0], C1);
  full_adder FA1 (A[1], B[1], C1,  Sum[1], C2);
  full_adder FA2 (A[2], B[2], C2,  Sum[2], C3);
  full_adder FA3 (A[3], B[3], C3,  Sum[3], Cout);
endmodule

// 4-bit Ripple Carry Subtractor (A - B)
module subtractor4 (
  input  wire [3:0] A,     // Minuend
  input  wire [3:0] B,     // Subtrahend
  output wire [3:0] Diff,  // Difference = A - B
  output wire       Bout   // Borrow out (1 means borrow occurred)
);
  wire [3:0] B_comp;
  wire [3:0] Sum;
  wire       Cout;

  // Two's complement of B: ~B + 1
  assign B_comp = ~B;

  // A - B = A + (~B + 1)
  adder4 sub_adder (
    .A(A),
    .B(B_comp),
    .Cin(1'b1),
    .Sum(Sum),
    .Cout(Cout)
  );

  assign Diff = Sum;
  assign Bout = ~Cout;  // Borrow out (optional)
endmodule

// 4-bit Binary to 8-bit Seven Segment (active-low)
module Binary2Eight(
  input  wire signed [3:0] Num,
  output reg  [7:0]        SevenSeg
);
  always @(*) begin
    case (Num)
      4'sb0000: SevenSeg = 8'b11000000; //  0
      4'sb0001: SevenSeg = 8'b11111001; //  1
      4'sb0010: SevenSeg = 8'b10100100; //  2
      4'sb0011: SevenSeg = 8'b10110000; //  3
      4'sb0100: SevenSeg = 8'b10011001; //  4
      4'sb0101: SevenSeg = 8'b10010010; //  5
      4'sb0110: SevenSeg = 8'b10000010; //  6
      4'sb0111: SevenSeg = 8'b11111000; //  7
      4'sb1000: SevenSeg = 8'b00000000; // -8
      4'sb1001: SevenSeg = 8'b01111000; // -7
      4'sb1010: SevenSeg = 8'b00000010; // -6
      4'sb1011: SevenSeg = 8'b00010010; // -5
      4'sb1100: SevenSeg = 8'b00011001; // -4
      4'sb1101: SevenSeg = 8'b00110000; // -3
      4'sb1110: SevenSeg = 8'b00100100; // -2
      4'sb1111: SevenSeg = 8'b01111001; // -1
      default:  SevenSeg = 8'b11111111; // blank
    endcase
  end
endmodule


module lab7 (
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  input  wire [1:0]        Din,
  output reg  [7:0]        SevenSeg,
  output reg  [7:0]        SevenSeg2   // extra hex light
);
  wire signed [3:0] sum_add;
  wire signed [3:0] diff_sub;
  wire              cout_add;
  wire              bout_sub;
  wire [7:0]        seg_add;
  wire [7:0]        seg_sub;

  // 4-bit adder
  adder4 add_inst (
    .A(a),
    .B(b),
    .Cin(1'b0),
    .Sum(sum_add),
    .Cout(cout_add)
  );

  // 4-bit subtractor
  subtractor4 sub_inst (
    .A(a),
    .B(b),
    .Diff(diff_sub),
    .Bout(bout_sub)
  );

  // Binary to 7-segment for add result
  Binary2Eight display_add (
    .Num(sum_add),
    .SevenSeg(seg_add)
  );

  // Binary to 7-segment for sub result
  Binary2Eight display_sub (
    .Num(diff_sub),
    .SevenSeg(seg_sub)
  );

    // --- Add these wires in declarations ---
  wire ov_add;
  wire ov_sub;

  // --- Overflow detection (signed) ---
  assign ov_add = (a[3] == b[3]) && (sum_add[3] != a[3]);      // a + b
  assign ov_sub = (a[3] != b[3]) && (diff_sub[3] != a[3]);     // a - b

  // Control logic based on Din
  always @(*) begin
    // defaults (blank both to avoid latches)
    SevenSeg  = 8'b11111111;
    SevenSeg2 = 8'b11111111;

    case (Din)
      2'b00: begin
        // reset -> blank (defaults already set)
      end

      2'b01: begin
        // ADD: show digit when no overflow, otherwise light "1" on SevenSeg2
        if (ov_add) begin
          SevenSeg2 = 8'b11111001; // "1" active-low = overflow
        end else begin
          SevenSeg  = seg_add;
        end
      end

      2'b10: begin
        // SUB: show digit when no overflow, otherwise light "1" on SevenSeg2
        if (ov_sub) begin
          SevenSeg2 = 8'b11111001; // "1" active-low = overflow
        end else begin
          SevenSeg  = seg_sub;
        end
      end

      2'b11: begin
        // Compare a and b on SevenSeg2
        if (a > b)
          SevenSeg2 = 8'b11111001; // "1"
        else if (b > a)
          SevenSeg2 = 8'b11000000; // "0"
        else
          SevenSeg2 = 8'b11111111; // equal -> blank
      end

      default: begin
        // keep blanks
      end
    endcase
  end
endmodule








  















