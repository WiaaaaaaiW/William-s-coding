// 3-bit Comparator
module compare3(A, B, eq, gt, lt);
  input  [2:0] A, B;
  output eq, gt, lt;

  assign eq = (A == B);   // equal
  assign gt = (A >  B);   // greater than
  assign lt = (A <  B);   // less than
endmodule


// 1-bit Full Adder
module full_adder (A, B, Cin, Sum, Cout);
  input  A, B, Cin;
  output Sum, Cout;

  assign Sum  = A ^ B ^ Cin;                      // XOR for sum
  assign Cout = (A & B) | (B & Cin) | (A & Cin);  // carry logic
endmodule


// 3-bit Ripple Carry Adder
module adder4 (A, B, Cin, Sum);
  input  [2:0] A, B;
  input        Cin;
  output [2:0] Sum;

  wire C1, C2;   // intermediate carries

  // Instantiate 4 full adders
  full_adder FA0 (A[0], B[0], Cin,  Sum[0], C1);
  full_adder FA1 (A[1], B[1], C1,   Sum[1], C2);
  full_adder FA2 (A[2], B[2], C2,   Sum[2], Cout);
endmodule


// 1-bit Full Subtractor
module full_subtractor(A, B, Bin, Diff, Bout);
  input  A, B, Bin;
  output Diff, Bout;

  assign Diff = A ^ B ^ Bin;                      // difference bit
  assign Bout = (~A & B) | (Bin & ~(A ^ B));      // borrow logic
endmodule


module sub3(A, B, Bin, Diff, Bout);
  input  [2:0] A, B;
  input        Bin;       // initial borrow-in (often 0)
  output [2:0] Diff;

  wire b1, b2, b3;

  full_subtractor FS0(A[0], B[0], Bin, Diff[0], b1);
  full_subtractor FS1(A[1], B[1], b1,  Diff[1], b2);
  full_subtractor FS2(A[2], B[2], b2,  Diff[2], Bout);
endmodule


module lab7(
  input signed [3:0] a;
  input signed [2:0] a2;
  input signed [3:0] b;
  input signed [2:0] b2;
  input C = 4'b0000;
  output D0, D1, D2, D3, D4, D5, D6, D7;
  );

  input a,a2,b,b2,c;
  output D0, D1, D2, D3, D4, D5, D6, D7;
  wire eq1,eq2,gt1,gt2,lt1,lt2,Num1,Num2,Num3;

  compare3 AA(eq1,gt1,lt1,a,c);
  compare3 AB(eq2,gt2,lt2,b,c);

  always @(*) begin
    if (gt1>0 && gt2>0)
        adder3 BA(Num1,a2,b2);
    else if (gt1<0 && gt2>0)
        sub3 BB(Num2,a2,b2);
    else if (gt1>0 && gt2<0)
        sub3 BC(Num3,a2,b2);
    else if (gt1<0 && gt2<0)
        adder3 BD(Num3,a2,b2)
  end

  















