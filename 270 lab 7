// 1-bit full adder module
module adder1(A,B,C,S,Cout);
  input A,B,C;
  output S,Cout;
  wire wire1,wire2,wire3;
  
  xor	AA(wire1,A,B);
  xor	BA(S,wire1,C);
  and	CA(wire2,A,B);
  and	DA(wire3,wire1,C);
  or	EA(Cout,wire2,wire3);
endmodule
// → This module defines a 1-bit full adder using basic logic gates (XOR, AND, OR).

// 3-bit ripple-carry adder module using three 1-bit adders
module adder3(A0,B0,A1,B1,A2,B2,Coin,S0,S1,S2,Cout2);
  input A0,B0,A1,B1,A2,B2,Coin;
  output S0,S1,S2,Cout2;
  wire Cout0,Cout1;
  
  adder1	F(A0,B0,Coin,S0,Cout0);
  adder1	G(A1,B1,Cout0,S1,Cout1);
  adder1	H(A2,B2,Cout1,S2,Cout2);

endmodule
// → This module connects three 1-bit adders in series to create a 3-bit ripple-carry adder.


// 4-bit Binary to 8-bit Seven Segment
module Binary2Eight(
  input [3:0] Num,
  output reg [7:0] SevenSeg
);
  always@(*) begin
    case(Num)
      4'b0000: SevenSeg = 8'b11000000; // 0
      4'b0001: SevenSeg = 8'b11111001; // 1
      4'b0010: SevenSeg = 8'b10100100; // 2
      4'b0011: SevenSeg = 8'b10110000; // 3
      4'b0100: SevenSeg = 8'b10011001; // 4
      4'b0101: SevenSeg = 8'b10010010; // 5
      4'b0110: SevenSeg = 8'b10000010; // 6
      4'b0111: SevenSeg = 8'b11111000; // 7
      4'b1000: SevenSeg = 8'b00000000; // -8
      4'b1001: SevenSeg = 8'b01111000; // -7
      4'b1010: SevenSeg = 8'b00000010; // -6
      4'b1011: SevenSeg = 8'b00010010; // -5
      4'b1100: SevenSeg = 8'b00011001; // -4
      4'b1101: SevenSeg = 8'b00110000; // -3
      4'b1110: SevenSeg = 8'b00100100; // -2
      4'b1111: SevenSeg = 8'b01111001; // -1
      default: SevenSeg = 8'b11111111;
    endcase
  end
endmodule


