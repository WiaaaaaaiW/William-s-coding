module clock(
    input  wire clk_50M,
    output reg  clk_1
);
    reg [27:0] counter = 0;

    always @(posedge clk_50M) begin
        if (counter == 28'd25_000_000) begin
            counter <= 0;
            clk_1 <= ~clk_1;
        end else begin
            counter <= counter + 1;
        end
    end
endmodule

// 4-bit Binary to 8-bit Seven Segment (active-low)
module Binary2Eight(
  input  wire signed [3:0] Num,
  output reg  [7:0]        SevenSeg
);
  always @(*) begin
    case(Num)
        4'b0000: SevenSeg = 7'b1000000; // 0
        4'b0001: SevenSeg = 7'b1111001; // 1
        4'b0010: SevenSeg = 7'b0100100; // 2
        4'b0011: SevenSeg = 7'b0110000; // 3
        4'b0100: SevenSeg = 7'b0011001; // 4
        4'b0101: SevenSeg = 7'b0010010; // 5
        4'b0110: SevenSeg = 7'b0000010; // 6
        4'b0111: SevenSeg = 7'b1111000; // 7
        4'b1000: SevenSeg = 7'b0000000; // 8
        4'b1001: SevenSeg = 7'b0010000; // 9
        4'b1010: SevenSeg = 7'b0001000; // A
        4'b1011: SevenSeg = 7'b0000011; // B
        4'b1100: SevenSeg = 7'b1000110; // C
        4'b1101: SevenSeg = 7'b0100001; // D
        4'b1110: SevenSeg = 7'b0000110; // E
        4'b1111: SevenSeg = 7'b0001110; // F
     endcase
  end
endmodule

module lab8(CLK_50M,select,reset,sevenseg);
  input CLK_50M;// location is PIN_AF14
  input reset,select;
  output [6:0]sevenseg; //output for 7 segment display
  reg [3:0] q;
  wire clk_1;
  clock a(CLK_50M, clk_1);
  ssd_hex x(q,sevenseg);

  // Main counter logic
  always @(posedge clk_1 or posedge reset) begin
      if (reset)
        q <= 4'b0000;
      else if (select) begin           // count up
        if (q == 4'd9)
          q <= 4'b0000;               // wrap 9 → 0
        else
          q <= q + 1'b1;
        end

      else begin                       // count down
        if (q == 4'd0)
          q <= 4'd9;                  // wrap 0 → 9
        else
          q <= q - 1'b1;
      end
    end
endmodule
