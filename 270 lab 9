module myFSM(
    input clk,
    input cent_25,
    input cent_50,
    input reset,
    output reg food,
    output reg change,
    output reg [3:0] stateDisplay
);

reg [1:0] state;
parameter S0 = 2'b00,
          S1 = 2'b01,
          S2 = 2'b10; // 50¢ holding state

// Sequential Block: state transitions and synchronous outputs
always @(posedge clk)
begin
    if (reset) begin
        state <= S0;
        food <= 0;
        change <= 0;
    end
    else if (!(cent_25 & cent_50)) begin // ignore simultaneous input
        // Default outputs
        food <= 0;
        change <= 0;

        case(state)
            S0: begin
                if (cent_25)
                    state <= S1;
                else if (cent_50)
                    state <= S2;
            end
            S1: begin
                if (cent_25)
                    state <= S2;           // 25+25=50
                else if (cent_50) begin
                    state <= S0;           // 25+50=75 → dispense
                    food <= 1;
                end
            end
            S2: begin
                if (cent_25) begin
                    state <= S0;           // 50+25=75 → dispense
                    food <= 1;
                end
                else if (cent_50) begin
                    state <= S0;           // 50+50=100 → dispense + change
                    food <= 1;
                    change <= 1;
                end
            end
        endcase
    end
end

// Optional: display current state on LEDs
always @* begin
    stateDisplay = state;
end

endmodule

