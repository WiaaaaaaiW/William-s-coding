`timescale 1ns/1ps

module testbench();
  // Input signals for the DUT
  reg A0, A1, A2;   // 3 input bits (A2 is MSB, A0 is LSB)

  // Output signals from the DUT
  wire D0, D1, D2, D3, D4, D5, D6, D7;  // 8 decoded outputs

  // Helpful combined wires
  wire [2:0] A = {A2, A1, A0};          // Concatenate inputs into a 3-bit vector
  wire [7:0] D = {D7, D6, D5, D4, D3, D2, D1, D0};  // Combine outputs into 8-bit vector

  // Device Under Test (decoder3)
  // Using **named ports** avoids connection mistakes
  decoder3 UUT (
    .A0(A0), .A1(A1), .A2(A2),
    .D0(D0), .D1(D1), .D2(D2), .D3(D3),
    .D4(D4), .D5(D5), .D6(D6), .D7(D7)
  );

  // Test sequence
  initial begin
    // Generate VCD waveform file for GTKWave simulation
    $dumpfile("dump.vcd");
    $dumpvars(0);

    // ---- Vector 1 ----
    {A2,A1,A0} = 3'b000;     // Apply input 000
    #1;                      // Wait for 1 ns
    $display("A2=%b  A=%b (%0d)  ->  D=%b", A2, A, A, D); // Print results

    // ---- Vector 2 ----
    {A2,A1,A0} = 3'b101;     // Apply input 101
    #1;                      
    $display("A2=%b  A=%b (%0d)  ->  D=%b", A2, A, A, D);

    // ---- Vector 3 ----
    {A2,A1,A0} = 3'b000;     // Apply input 000 again to check repeat behavior
    #1;
    $display("A2=%b  A=%b (%0d)  ->  D=%b", A2, A, A, D);

    // ---- Vector 4 ----
    {A2,A1,A0} = 3'b011;     // Apply input 011
    #1;
    $display("A2=%b  A=%b (%0d)  ->  D=%b", A2, A, A, D);

    // ---- Vector 5 ----
    {A2,A1,A0} = 3'b111;     // Apply input 111 (all high)
    #1;
    $display("A2=%b  A=%b (%0d)  ->  D=%b", A2, A, A, D);

    #1 $finish;               // End simulation after final vector
  end
endmodule
