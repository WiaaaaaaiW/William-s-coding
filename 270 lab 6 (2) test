`timescale 1ns/1ps

module testbench();
  // Inputs to DUT
  reg [3:0] Num;

  // Outputs from DUT
  wire [6:0] SevenSeg;

  // Device Under Test — use **named ports** to avoid order mistakes
  lab62 UUT (
    .Num(Num),
    .SevenSeg(SevenSeg)
  );

  initial begin
    // Wave dump
    $dumpfile("dump.vcd");
    $dumpvars(0);

    // ---- Vector 1 ----
    Num = 4'b0000; // 0
    #1;
    $display("Vector 1: Num=%b (%0d) -> SevenSeg=%b", Num, Num, SevenSeg);

    // ---- Vector 2 ----
    Num = 4'b0101; // 5
    #1;
    $display("Vector 2: Num=%b (%0d) -> SevenSeg=%b", Num, Num, SevenSeg);

    // ---- Vector 3 ----
    Num = 4'b1001; // 9
    #1;
    $display("Vector 3: Num=%b (%0d) -> SevenSeg=%b", Num, Num, SevenSeg);

    // ---- Vector 4 ----
    Num = 4'b1010; // A
    #1;
    $display("Vector 4: Num=%b (%0d) -> SevenSeg=%b", Num, Num, SevenSeg);

    // ---- Vector 5 ----
    Num = 4'b1111; // F
    #1;
    $display("Vector 5: Num=%b (%0d) -> SevenSeg=%b", Num, Num, SevenSeg);

    #1 $finish;
  end
endmodule

