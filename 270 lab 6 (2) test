// or browse Examples
`timescale 1ns/1ps

module testbench();
  // Inputs to DUT
  reg A0, A1, A2;

  // Outputs from DUT
  wire D0, D1, D2, D3, D4, D5, D6, D7;
  wire [6:0] SevenSeg;

  // Helpful vectors for printing
  wire [2:0] A = {A2, A1, A0};
  wire [7:0] D = {D7, D6, D5, D4, D3, D2, D1, D0};

  // Device Under Test — use **named ports** to avoid order mistakes
  ssdd UUT (
    .A0(A0), .A1(A1), .A2(A2),
    .D0(D0), .D1(D1), .D2(D2), .D3(D3),
    .D4(D4), .D5(D5), .D6(D6), .D7(D7),
    .SevenSeg(SevenSeg)
  );

  initial begin
    // Wave dump
    $dumpfile("dump.vcd");
    $dumpvars(0);

    // ---- Vector 1 ----
    {A2,A1,A0} = 3'b000;
    #1;
    $display("A2=%b  A=%b (%0d)  ->  D=%b  SevenSeg=%b", A2, A, A, D, SevenSeg);

    // ---- Vector 2 ----
    {A2,A1,A0} = 3'b101;
    #1;
    $display("A2=%b  A=%b (%0d)  ->  D=%b  SevenSeg=%b", A2, A, A, D, SevenSeg);

    // ---- Vector 3 ----
    {A2,A1,A0} = 3'b000;
    #1;
    $display("A2=%b  A=%b (%0d)  ->  D=%b  SevenSeg=%b", A2, A, A, D, SevenSeg);

    // ---- Vector 4 ----
    {A2,A1,A0} = 3'b011;
    #1;
    $display("A2=%b  A=%b (%0d)  ->  D=%b  SevenSeg=%b", A2, A, A, D, SevenSeg);

    // ---- Vector 5 ----
    {A2,A1,A0} = 3'b111;
    #1;
    $display("A2=%b  A=%b (%0d)  ->  D=%b  SevenSeg=%b", A2, A, A, D, SevenSeg);

    #1 $finish;
  end
endmodule
