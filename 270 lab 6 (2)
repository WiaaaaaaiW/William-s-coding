module decoder2(X0, X1, enable, Y0, Y1, Y2, Y3);
  input X0, X1, enable;
  output Y0, Y1, Y2, Y3;
  wire wire1, wire2;
  
  not AA(wire1, X0);
  not BA(wire2, X1);
  
  and CA(Y0, wire1, wire2, enable);
  and DA(Y1, wire2, X0, enable);
  and EA(Y2, wire1, X1, enable);
  and FA(Y3, X0, X1, enable);
endmodule

// 3x8 decoder module using two 2x4 decoder modules
module decoder3(A0, A1, A2,D0, D1, D2, D3, D4, D5, D6, D7);
  input A0, A1, A2;
  output D0, D1, D2, D3, D4, D5, D6, D7;
  wire wire3;
  
  not GA(wire3, A2);
  
  // Lower 4 outputs enabled when A2=0
  decoder2 HA(A0, A1, wire3, D0, D1, D2, D3);
  
  // Upper 4 outputs enabled when A2=1
  decoder2 IA(A0, A1, A2, D4, D5, D6, D7);
endmodule


module ssd_hex(
	input [3:0] Num,
	output reg [6:0] SevenSeg
	);

	always@(*)
	begin
  		case(Num)
			4'b0000: SevenSeg = 7'b1000000; //0
			4'b0001: SevenSeg = 7'b1111001; //1
			4'b0010: SevenSeg = 7'b1000000; //2
			4'b0000: SevenSeg = 7'b1000000;	//3
			4'b0000: SevenSeg = 7'b1000000;	//4
			4'b0000: SevenSeg = 7'b1000000;	//5
			4'b0000: SevenSeg = 7'b1000000;	//6
			4'b0000: SevenSeg = 7'b1000000;	//7
			4'b0000: SevenSeg = 7'b1000000;	//8
			4'b0000: SevenSeg = 7'b1000000;	//9
			4'b0000: SevenSeg = 7'b1000000;	//A
			4'b0000: SevenSeg = 7'b1000000;	//B
			4'b0000: SevenSeg = 7'b1000000;	//C
			4'b0000: SevenSeg = 7'b1000000;	//D
	 		4'b1110: SevenSeg = 7'b0000110; //E
	 		4'b1111: SevenSeg = 7'b0001110; //F
		endcase
	end
endmodule
