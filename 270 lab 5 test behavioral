module adder_behavioral (A,B,Cin,Sum,Cout);
	input [1:0] A;
	input [1:0] B;
	input Cin;
	output [1:0] Sum;
	output Cout;

	reg [2:0] tmp;
	assign Cout= tmp[2];
	assign Sum = tmp[1:0];

	always@(A,B,Cin)
	  case({A,B,Cin})
	    5'b00000: tmp = 3'b000;
	    5'b00110: tmp = 3'b011;
	    5'b00010: tmp = 3'b001;
	    5'b00001: tmp = 3'b001;
	    5'b00011: tmp = 3'b010;
	    5'b00100: tmp = 3'b010;
	    5'b00101: tmp = 3'b011;
	    5'b01000: tmp = 3'b001;
	    5'b00111: tmp = 3'b100;
	    5'b01001: tmp = 3'b010;
	    5'b01010: tmp = 3'b010;
	    5'b01100: tmp = 3'b011;
	    5'b01011: tmp = 3'b011;
	    5'b01101: tmp = 3'b100;
	    5'b10010: tmp = 3'b011;
	    5'b10110: tmp = 3'b101;
	    5'b10111: tmp = 3'b101;
	    5'b11100: tmp = 3'b101;
	    5'b11110: tmp = 3'b110;
	    5'b11101: tmp = 3'b110;
	    5'b11111: tmp = 3'b111;
	    5'b01110: tmp = 3'b100;
	    5'b10011: tmp = 3'b100;
	    5'b10100: tmp = 3'b100;
	    5'b10101: tmp = 3'b101;
	    5'b11000: tmp = 3'b011;
	    5'b11001: tmp = 3'b100;
	    5'b11011: tmp = 3'b101;
	    5'b01111: tmp = 3'b101;
	    5'b10000: tmp = 3'b010;
	    5'b10001: tmp = 3'b011;
	    5'b11010: tmp = 3'b100;
	  endcase

endmodule


module testbench();
  // Inputs to DUT
  reg A0, B0, A1, B1, A2, B2, Coin;

  // Outputs from DUT
  wire S0, S1, S2, Cout2;

  // Helpful vectors for printing
  wire [2:0] A = {A2, A1, A0};
  wire [2:0] B = {B2, B1, B0};
  wire [2:0] S = {S2, S1, S0};
  wire [1:0] A4 = {A1, A0};
  wire [1:0] B4 = {B1, B0};
  wire [1:0] S4;
  wire Cout4;

  // DUT
  lab5 UUT (
    .A0(A0), .B0(B0),
    .A1(A1), .B1(B1),
    .A2(A2), .B2(B2),
    .Coin(Coin),
    .S0(S0), .S1(S1), .S2(S2),
    .Cout2(Cout2)
  );

  // 2-bit adder instance
  adder_behavioral I (
    .A(A4),
    .B(B4),
    .Cin(Coin),
    .Sum(S4),
    .Cout(Cout4)
  );

  initial begin
    $dumpfile("dump.vcd");
    $dumpvars(0, testbench);

    // ---- Vector 1 ----
    {A2,A1,A0} = 3'b101;  // A = 5
    {B2,B1,B0} = 3'b011;  // B = 3
    Coin = 1'b0;
    #1;
    $display("A=%b (%0d)  B=%b (%0d)  Cin=%b  ->  S=%b (%0d) Cout=%b",
             A, A, B, B, Coin, S, S, Cout2);

    // ---- Vector 2 ----
    {A2,A1,A0} = 3'b001;  // A = 1
    {B2,B1,B0} = 3'b011;  // B = 3
    Coin = 1'b0;
    #1;
    $display("A=%b (%0d)  B=%b (%0d)  Cin=%b  ->  S=%b (%0d) Cout=%b",
             A, A, B, B, Coin, S, S, Cout2);

    // ---- Vector 3 (2-bit test only) ----
    {A1,A0} = 2'b01;  // A = 1
    {B1,B0} = 2'b10;  // B = 2
    Coin = 1'b0;
    #1;
    $display("A4=%b (%0d)  B4=%b (%0d)  Cin=%b  ->  S4=%b (%0d) Cout=%b",
             A4, A4, B4, B4, Coin, S4, S4, Cout4);

    #1 $finish;
  end
endmodule
